{
    "manifest_version": 3,
    "name": "Minions Council",
    "version": "0.1.0",
    "description": "Your council of LLM minions in Chrome: compare ChatGPT, Claude, Gemini, and Grok directly in your provider tabs, no API keys.",
    "permissions": ["sidePanel", "scripting", "storage", "tabs", "debugger"],
    "host_permissions": [
        "https://gemini.google.com/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
            "js": [
                "runtime/content/captureEngine.js",
                "runtime/content/providers/chatgptCapture.js",
                "runtime/content/providers/geminiCapture.js",
                "runtime/content/providers/claudeCapture.js",
                "runtime/content/providers/grokCapture.js",
                "captureUtils.js",
                "contentScript.js"
            ]
        },
        {
            "matches": ["https://gemini.google.com/*"],
            "js": [
                "runtime/content/captureEngine.js",
                "runtime/content/providers/chatgptCapture.js",
                "runtime/content/providers/geminiCapture.js",
                "runtime/content/providers/claudeCapture.js",
                "runtime/content/providers/grokCapture.js",
                "captureUtils.js",
                "contentScript.js"
            ]
        },
        {
            "matches": ["https://claude.ai/*"],
            "js": [
                "runtime/content/captureEngine.js",
                "runtime/content/providers/chatgptCapture.js",
                "runtime/content/providers/geminiCapture.js",
                "runtime/content/providers/claudeCapture.js",
                "runtime/content/providers/grokCapture.js",
                "captureUtils.js",
                "contentScript.js"
            ]
        },
        {
            "matches": ["https://grok.com/*", "https://*.grok.com/*"],
            "js": [
                "runtime/content/captureEngine.js",
                "runtime/content/providers/chatgptCapture.js",
                "runtime/content/providers/geminiCapture.js",
                "runtime/content/providers/claudeCapture.js",
                "runtime/content/providers/grokCapture.js",
                "captureUtils.js",
                "contentScript.js"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "action": {
        "default_title": "Click to open Minions Council",
        "default_icon": {
            "16": "variant-icons/variant-16.png",
            "32": "variant-icons/variant-32.png",
            "48": "variant-icons/variant-48.png",
            "128": "variant-icons/variant-128.png"
        }
    },
    "author": "Minions Council Team",
    "homepage_url": "https://github.com/AmT42/multi-llm-ext",
    "icons": {
        "16": "variant-icons/variant-16.png",
        "32": "variant-icons/variant-32.png",
        "48": "variant-icons/variant-48.png",
        "128": "variant-icons/variant-128.png"
    },
    "version_name": "dev-main"
}
